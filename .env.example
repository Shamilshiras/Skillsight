# SkillSight Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-skillsight-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Options: 'sqlite3' (zero-config local dev) or 'mysql' (production / full stack)
DB_ENGINE=sqlite3
DB_NAME=skillsight_db
DB_USER=skillsight_user
DB_PASSWORD=skillsight_pass
DB_HOST=127.0.0.1
DB_PORT=3306

# Job APIs (optional API keys, Arbeitnow works with no key required)
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Airflow Settings
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
